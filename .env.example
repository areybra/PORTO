# --- Vercel + Supabase PostgreSQL (Production) ---
# Supabase Dashboard -> Project Settings -> Database -> Connection string (URI / Pooled)
# WAJIB gunakan pooled (PgBouncer) untuk Vercel serverless agar tidak exhaust connections
# Contoh POOLED (6543, pgbouncer=true) -> untuk Vercel / serverless:
# DATABASE_URL=postgresql://postgres.xxxxx:YOUR_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# Contoh DIRECT (5432) -> untuk migrate lokal saja, jangan dipakai di Vercel production
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.xxxxx.supabase.co:5432/postgres

DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.xxxxx.supabase.co:5432/postgres

# Alternatif split vars (jika tidak pakai DATABASE_URL) - isi dari Supabase Settings
POSTGRES_DATABASE=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YOUR_PASSWORD
POSTGRES_HOST=db.xxxxx.supabase.co
POSTGRES_PORT=5432

# Vercel env auto
# VERCEL_URL automatically set by Vercel
# SITE_URL harus diisi domain vercel final, mis https://areybra.vercel.app atau custom domain
