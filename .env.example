# --- Vercel + Supabase PostgreSQL (Production) ---
# PENTING: Vercel HANYA bisa via Pooler (IPv4). Direct db.* supabase.co adalah IPv6-only → 500 error di Vercel!
# Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI -> pilih "Pooled" (port 6543)
# Project ref keziemwdfnafczrfwahi ada di region ap-northeast-2, jadi host poolernya:
#   aws-0-ap-northeast-2.pooler.supabase.com:6543  (user = postgres.keziemwdfnafczrfwahi)
# Contoh POOLED (WAJIB untuk Vercel):
# DATABASE_URL=postgresql://postgres.keziemwdfnafczrfwahi:YOUR_PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres
# Contoh DIRECT (5432, IPv6) -> JANGAN dipakai di Vercel, hanya fallback lokal & akan error 500
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.keziemwdfnafczrfwahi.supabase.co:5432/postgres

DATABASE_URL=postgresql://postgres.keziemwdfnafczrfwahi:YOUR_PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres

# Alternatif split vars (jika tidak pakai DATABASE_URL) - isi dari Supabase Settings
POSTGRES_DATABASE=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YOUR_PASSWORD
POSTGRES_HOST=db.xxxxx.supabase.co
POSTGRES_PORT=5432

# Vercel env auto
# VERCEL_URL automatically set by Vercel
# SITE_URL harus diisi domain vercel final, mis https://areybra.vercel.app atau custom domain
