{
  "version": 2,
  "installCommand": "pip install -r requirements.txt && npm install",
  "buildCommand": "npm run build && python manage.py collectstatic --noinput --settings=config.settings.production",
  "builds": [
    { "src": "api/index.py", "use": "@vercel/python", "config": { "maxLambdaSize": "15mb", "runtime": "python3.12" } }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "api/index.py" }
  ]
}
